<?xml version="1.0" encoding="utf-8"?>
<!-- Trang Main (UI-SPEC §2) — bản WPF: Views\MainView.xaml(.cs) + ViewModels\MainViewModel.cs + TrayGridViewModel.cs.
     Không binding: control có x:Name, MainPage.xaml.cpp đọc Core trong OnTick (100 ms) và chỉ ghi khi giá trị đổi.
     Hai card tray (ui::TrayCard), ba khung CAM (ui::MainCamFrame) và danh sách log (ui::LogListView) dựng bằng code vào
     các ô *Host dưới đây. -->
<UserControl
    x:Class="ShieldCanAssy.MainPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:ShieldCanAssy">

    <UserControl.Resources>
        <!-- Công tắc AUTO/MANUAL (MA-1): rãnh bo tròn, con trượt màu nằm dưới chữ chế độ ĐANG áp dụng (Status.Mode) — không
             theo cú bấm, nên McControl từ chối AUTO thì nó đứng yên. Template riêng (không FlatButtonStyle) để nội dung giãn
             hết rãnh. -->
        <SolidColorBrush x:Key="ModeTrackBrush" Color="#0F000000"/>
        <SolidColorBrush x:Key="ModeTrackHoverBrush" Color="#17000000"/>
        <SolidColorBrush x:Key="ModeTrackPressedBrush" Color="#1F000000"/>
        <Style x:Key="ModeSwitchStyle" TargetType="Button">
            <Setter Property="Height" Value="40"/>
            <Setter Property="MinHeight" Value="0"/>
            <Setter Property="HorizontalAlignment" Value="Stretch"/>
            <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
            <Setter Property="VerticalContentAlignment" Value="Stretch"/>
            <Setter Property="UseSystemFocusVisuals" Value="True"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Track" Background="{StaticResource ModeTrackBrush}"
                                BorderBrush="{StaticResource ControlStrokeSecondaryBrush}" BorderThickness="1"
                                CornerRadius="20" Padding="3">
                            <ContentPresenter x:Name="ContentPresenter" Content="{TemplateBinding Content}"
                                              HorizontalContentAlignment="Stretch" VerticalContentAlignment="Stretch"
                                              AutomationProperties.AccessibilityView="Raw"/>
                            <VisualStateManager.VisualStateGroups>
                                <VisualStateGroup x:Name="CommonStates">
                                    <VisualState x:Name="Normal"/>
                                    <VisualState x:Name="PointerOver">
                                        <VisualState.Setters>
                                            <Setter Target="Track.Background" Value="{StaticResource ModeTrackHoverBrush}"/>
                                        </VisualState.Setters>
                                    </VisualState>
                                    <VisualState x:Name="Pressed">
                                        <VisualState.Setters>
                                            <Setter Target="Track.Background" Value="{StaticResource ModeTrackPressedBrush}"/>
                                        </VisualState.Setters>
                                    </VisualState>
                                    <VisualState x:Name="Disabled"/>
                                </VisualStateGroup>
                            </VisualStateManager.VisualStateGroups>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style x:Key="ModeSwitchLabelStyle" TargetType="TextBlock">
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="Foreground" Value="{StaticResource TextSecondaryBrush}"/>
            <Setter Property="HorizontalAlignment" Value="Center"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
            <Setter Property="IsHitTestVisible" Value="False"/>
        </Style>
        <!-- RUN/STOP (H 52, 18 Bold) và nút phụ (H 40, SemiBold) — ba kiểu điều khiển của card Operation (Tuấn 2026-10-13). -->
        <Style x:Key="OpPrimaryButtonStyle" TargetType="Button" BasedOn="{StaticResource FlatButtonStyle}">
            <Setter Property="Height" Value="52"/>
            <Setter Property="FontSize" Value="18"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="HorizontalAlignment" Value="Stretch"/>
        </Style>
        <Style x:Key="OpSecondaryButtonStyle" TargetType="Button" BasedOn="{StaticResource FlatButtonStyle}">
            <Setter Property="Height" Value="40"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="HorizontalAlignment" Value="Stretch"/>
        </Style>
        <!-- Bảng Cycle/Tack Time (MA-16): ô kẻ viền, nhãn 11 Secondary, số 15 SemiBold. -->
        <Style x:Key="CtCellStyle" TargetType="Border">
            <Setter Property="BorderBrush" Value="{StaticResource DividerBrush}"/>
            <Setter Property="Padding" Value="6,3"/>
            <Setter Property="Background" Value="Transparent"/>
        </Style>
        <Style x:Key="CtLabelStyle" TargetType="TextBlock">
            <Setter Property="FontSize" Value="11"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
            <Setter Property="Foreground" Value="{StaticResource TextSecondaryBrush}"/>
        </Style>
        <Style x:Key="CtValueStyle" TargetType="TextBlock">
            <Setter Property="FontSize" Value="15"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
            <Setter Property="Text" Value="—"/>
        </Style>
        <Style x:Key="CounterCaptionStyle" TargetType="TextBlock">
            <Setter Property="FontSize" Value="11"/>
            <Setter Property="Foreground" Value="{StaticResource TextSecondaryBrush}"/>
        </Style>
    </UserControl.Resources>

    <Grid x:Name="Root" Loaded="OnRootLoaded">
        <!-- Cột trái/phải hẹp, ưu tiên bề ngang cho cột giữa (màn hình máy 4:3). -->
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="250"/>
            <ColumnDefinition Width="*"/>
            <ColumnDefinition Width="Auto"/>
        </Grid.ColumnDefinitions>

        <!-- ═══ Cột trái: vận hành + sản lượng. Cuộn được (màn 1280×1024, banner chờ tray); lề phải nằm TRONG vùng cuộn vì
             thanh cuộn WinUI nằm đè lên nội dung. ═══ -->
        <ScrollViewer x:Name="LeftScroll" Grid.Column="0" VerticalScrollBarVisibility="Auto" HorizontalScrollMode="Disabled">
            <StackPanel Margin="0,0,8,0" Spacing="8">

                <!-- ── MODE (MA-1) — card riêng, tách khỏi OPERATION (Tuấn 2026-10-19) ── -->
                <Border Style="{StaticResource CardBorderStyle}" Padding="0">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>
                        <Border Style="{StaticResource CardHeaderStyle}">
                            <TextBlock Text="MODE" Style="{StaticResource SectionHeaderStyle}"/>
                        </Border>
                        <Border Grid.Row="1" Style="{StaticResource DividerStyle}"/>
                        <Button x:Name="ModeSwitch" Grid.Row="2" Style="{StaticResource ModeSwitchStyle}" Margin="12"
                                Click="OnModeClick">
                                <Grid x:Name="ModeSwitchTrack" SizeChanged="OnModeTrackSizeChanged">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                    <Border x:Name="ModeThumb" Grid.Column="0" CornerRadius="16"
                                            Background="{StaticResource CautionOnBrush}">
                                        <Border.RenderTransform>
                                            <TranslateTransform x:Name="ModeThumbTransform"/>
                                        </Border.RenderTransform>
                                    </Border>
                                    <TextBlock x:Name="ModeAutoText" Grid.Column="0" Text="AUTO"
                                               Style="{StaticResource ModeSwitchLabelStyle}"/>
                                    <TextBlock x:Name="ModeManualText" Grid.Column="1" Text="MANUAL"
                                               Style="{StaticResource ModeSwitchLabelStyle}"/>
                                </Grid>
                        </Button>
                    </Grid>
                </Border>

                <!-- ── OPERATION (§2.1) ── -->
                <Border Style="{StaticResource CardBorderStyle}" Padding="0">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>
                        <Border Style="{StaticResource CardHeaderStyle}">
                            <TextBlock Text="OPERATION" Style="{StaticResource SectionHeaderStyle}"/>
                        </Border>
                        <Border Grid.Row="1" Style="{StaticResource DividerStyle}"/>
                        <StackPanel Grid.Row="2" Margin="12">
                            <!-- MA-2…7: sáu nút một lưới hai cột BẰNG NHAU, chữ IN HOA (Tuấn 2026-10-19; trước đó Origin:Init 2:1).
                                 RUN cạnh STOP như cặp nút bảng điều khiển — RUN chỉ vào Armed, máy chạy thật bắt buộc nút Start
                                 cứng; INIT vẫn nằm cạnh ORIGIN ("press Init (next to Origin)"). -->
                            <Grid ColumnSpacing="6" RowSpacing="6">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                </Grid.RowDefinitions>
                                <Button x:Name="RunButton" Content="RUN" Style="{StaticResource OpPrimaryButtonStyle}"
                                        Background="{StaticResource StatusOffBrush}" BorderBrush="{StaticResource StatusOffBrush}"
                                        Foreground="{StaticResource TextOnAccentBrush}" Click="OnRunClick"/>
                                <Button x:Name="StopButton" Grid.Column="1" Content="STOP"
                                        Style="{StaticResource OpPrimaryButtonStyle}" Click="OnStopClick"/>
                                <Button x:Name="OriginButton" Grid.Row="1" Content="ORIGIN"
                                        Style="{StaticResource OpSecondaryButtonStyle}" Click="OnOriginClick"/>
                                <Button x:Name="InitButton" Grid.Row="1" Grid.Column="1" Content="INIT"
                                        Style="{StaticResource OpSecondaryButtonStyle}"/>
                                <Button x:Name="ResetButton" Grid.Row="2" Content="RESET"
                                        Style="{StaticResource OpSecondaryButtonStyle}" Click="OnResetClick"/>
                                <Button x:Name="MuteButton" Grid.Row="2" Grid.Column="1" Content="MUTE"
                                        Style="{StaticResource OpSecondaryButtonStyle}" Click="OnMuteClick"/>
                            </Grid>

                            <!-- MA-10 (chờ tray — chỉ NHẮC, nạp tray bằng nút Start cứng) + MA-11 (vì sao lệnh vừa rồi không thực
                                 hiện được): MỘT ô cao cố định ngay dưới hàng nút, ẩn/hiện bằng ui::ShowInPlace. Trước 2026-10-20 là
                                 hai dải Collapsed — chờ tray bật/tắt mỗi lượt và câu Status đổi số dòng liên tục làm card
                                 PRODUCTION nhảy lên xuống (Tuấn). Cao 84 = chờ tray 2 dòng + câu Status 2 dòng, hoặc câu Status 4
                                 dòng; dài hơn cắt "…", đủ câu ở tooltip. -->
                            <Border x:Name="NoticeSlot" Style="{StaticResource NoticeSlotStyle}" Height="84" Margin="0,8,0,0">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                    <FontIcon Style="{StaticResource InfoBarWarningIconStyle}" Margin="0,1,8,0"/>
                                    <StackPanel Grid.Column="1" VerticalAlignment="Top">
                                        <TextBlock x:Name="WaitTrayText" Text="Trays in: press any Start button."
                                                   Style="{StaticResource NoticeLineStyle}" FontSize="13" FontWeight="Bold"
                                                   LineHeight="17" MaxLines="2" Visibility="Collapsed"/>
                                        <TextBlock x:Name="MessageText" Style="{StaticResource NoticeLineStyle}" MaxLines="4"/>
                                    </StackPanel>
                                </Grid>
                            </Border>

                            <!-- MA-8, MA-9, Vision NG: chế độ cài ở Setting — chỉ đổi khi người dùng đổi chế độ, không bật/tắt lúc
                                 máy chạy, nên vẫn Collapsed như thường. -->
                            <!-- MA-8: chỉ chạy một tay hút (chọn ở Setting). -->
                            <Border x:Name="OnlyNozzleBar" Background="{StaticResource CautionOnBrush}" CornerRadius="4"
                                    Padding="8,6" Margin="0,8,0,0" Visibility="Collapsed">
                                <TextBlock x:Name="OnlyNozzleText" TextWrapping="Wrap" FontSize="12" FontWeight="SemiBold"
                                           Foreground="{StaticResource TextOnAccentBrush}"/>
                            </Border>
                            <!-- MA-9: chạy rà đang bật, kèm tiến độ. -->
                            <Border x:Name="DryRunBar" Background="{StaticResource CautionBrush}" CornerRadius="4"
                                    Padding="8,6" Margin="0,8,0,0" Visibility="Collapsed">
                                <StackPanel>
                                    <TextBlock Text="DRY RUN — NO PRODUCT" FontWeight="Bold" FontSize="13"
                                               TextWrapping="Wrap" Foreground="{StaticResource TextOnAccentBrush}"/>
                                    <!-- Tiến độ đổi liên tục lúc chạy rà: giữ đúng 2 dòng để dải không cao/thấp theo số. -->
                                    <TextBlock x:Name="DryRunText" Style="{StaticResource NoticeLineStyle}" Height="32" MaxLines="2"
                                               Foreground="{StaticResource TextOnAccentBrush}"/>
                                </StackPanel>
                            </Border>
                            <!-- Dừng khi Vision NG đang bật (Tuấn 2026-10-18) — nhắc để không quên tắt khi chạy sản xuất. -->
                            <Border x:Name="NgStopBar" Background="{StaticResource YellowOnBrush}" CornerRadius="4"
                                    Padding="8,6" Margin="0,8,0,0" Visibility="Collapsed">
                                <StackPanel>
                                    <TextBlock Text="STOP ON VISION NG" FontWeight="Bold" FontSize="13"
                                               TextWrapping="Wrap" Foreground="{StaticResource TextOnYellowBrush}"/>
                                    <TextBlock Text="Auto halts at each Vision NG, machine left as is. Turn off in Setting." TextWrapping="Wrap"
                                               FontSize="12" Foreground="{StaticResource TextOnYellowBrush}"/>
                                </StackPanel>
                            </Border>
                        </StackPanel>
                    </Grid>
                </Border>

                <!-- ── PRODUCTION (§2.2) ── -->
                <Border Style="{StaticResource CardBorderStyle}" Padding="0">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>
                        <Border Style="{StaticResource CardHeaderStyle}" Padding="12,0,8,0">
                            <Grid>
                                <TextBlock Text="PRODUCTION" Style="{StaticResource SectionHeaderStyle}"/>
                                <!-- MA-12: không hỏi xác nhận (như WPF). -->
                                <Button x:Name="ClearCountersButton" Content="Clear" Width="80" Height="36" MinHeight="36"
                                        HorizontalAlignment="Right" VerticalAlignment="Center" Click="OnClearCountersClick"/>
                            </Grid>
                        </Border>
                        <Border Grid.Row="1" Style="{StaticResource DividerStyle}"/>
                        <StackPanel Grid.Row="2" Margin="12">
                            <!-- MA-13 -->
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <StackPanel>
                                    <TextBlock Text="OK" Style="{StaticResource CounterCaptionStyle}"/>
                                    <TextBlock x:Name="CountOkText" Text="0" FontSize="26" FontWeight="Bold"
                                               Foreground="{StaticResource SuccessBrush}"/>
                                </StackPanel>
                                <StackPanel Grid.Column="1">
                                    <TextBlock Text="NG" Style="{StaticResource CounterCaptionStyle}"/>
                                    <TextBlock x:Name="CountNgText" Text="0" FontSize="26" FontWeight="Bold"
                                               Foreground="{StaticResource CriticalBrush}"/>
                                </StackPanel>
                                <StackPanel Grid.Column="2">
                                    <TextBlock Text="Total" Style="{StaticResource CounterCaptionStyle}"/>
                                    <TextBlock x:Name="CountTotalText" Text="0" FontSize="26" FontWeight="Bold"/>
                                </StackPanel>
                            </Grid>
                            <Border Style="{StaticResource DividerStyle}" Margin="0,6"/>
                            <!-- MA-14 / MA-15 -->
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <StackPanel>
                                    <TextBlock Text="NG rate" Style="{StaticResource CounterCaptionStyle}"/>
                                    <TextBlock x:Name="NgRateText" Text="0.00 %" FontSize="16" FontWeight="SemiBold"/>
                                </StackPanel>
                                <StackPanel Grid.Column="1">
                                    <TextBlock Text="NG streak" Style="{StaticResource CounterCaptionStyle}"/>
                                    <TextBlock x:Name="NgStreakText" Text="0" FontSize="16" FontWeight="SemiBold"/>
                                </StackPanel>
                            </Grid>
                            <!-- MA-16: Cycle Time = tổng giờ thực của tray lắp ráp, Tack Time = trung bình một sản phẩm; "Last" =
                                 tray vừa xong. Tray xong thì Cycle/Tack Time giữ số vừa chốt tới khi tray mới bắt đầu. -->
                            <Border Margin="0,8,0,0" BorderThickness="1" BorderBrush="{StaticResource DividerBrush}">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="Auto"/>
                                    </Grid.RowDefinitions>
                                    <Border Style="{StaticResource CtCellStyle}" BorderThickness="0,0,1,1">
                                        <TextBlock Text="Cycle Time" Style="{StaticResource CtLabelStyle}"/>
                                    </Border>
                                    <Border x:Name="CycleTimeCell" Grid.Column="1" Style="{StaticResource CtCellStyle}"
                                            BorderThickness="0,0,0,1">
                                        <TextBlock x:Name="CycleTimeText" Style="{StaticResource CtValueStyle}"/>
                                    </Border>
                                    <Border Grid.Row="1" Style="{StaticResource CtCellStyle}" BorderThickness="0,0,1,1">
                                        <TextBlock Text="Last Cycle Time" Style="{StaticResource CtLabelStyle}"/>
                                    </Border>
                                    <Border x:Name="LastCycleTimeCell" Grid.Row="1" Grid.Column="1"
                                            Style="{StaticResource CtCellStyle}" BorderThickness="0,0,0,1">
                                        <TextBlock x:Name="LastCycleTimeText" Style="{StaticResource CtValueStyle}"/>
                                    </Border>
                                    <Border Grid.Row="2" Style="{StaticResource CtCellStyle}" BorderThickness="0,0,1,1">
                                        <TextBlock Text="Tack Time" Style="{StaticResource CtLabelStyle}"/>
                                    </Border>
                                    <Border x:Name="TackTimeCell" Grid.Row="2" Grid.Column="1"
                                            Style="{StaticResource CtCellStyle}" BorderThickness="0,0,0,1">
                                        <TextBlock x:Name="TackTimeText" Style="{StaticResource CtValueStyle}"/>
                                    </Border>
                                    <Border Grid.Row="3" Style="{StaticResource CtCellStyle}" BorderThickness="0,0,1,0">
                                        <TextBlock Text="Last Tack Time" Style="{StaticResource CtLabelStyle}"/>
                                    </Border>
                                    <Border x:Name="LastTackTimeCell" Grid.Row="3" Grid.Column="1"
                                            Style="{StaticResource CtCellStyle}">
                                        <TextBlock x:Name="LastTackTimeText" Style="{StaticResource CtValueStyle}"/>
                                    </Border>
                                </Grid>
                            </Border>
                            <!-- MA-17…19 -->
                            <TextBlock x:Name="UphText" Margin="0,6,0,0" FontSize="12" TextWrapping="Wrap"/>
                            <TextBlock x:Name="AutoStepText" FontSize="12" TextWrapping="Wrap"
                                       Foreground="{StaticResource TextSecondaryBrush}"/>
                            <TextBlock x:Name="LastCompText" FontSize="11" TextWrapping="Wrap"
                                       Foreground="{StaticResource TextSecondaryBrush}"/>
                        </StackPanel>
                    </Grid>
                </Border>
            </StackPanel>
        </ScrollViewer>

        <!-- ═══ Cột giữa: hai card tray (§2.3) trên, ba khung CAM (§2.4) lấp phần cao còn lại ═══ -->
        <Grid Grid.Column="1" Margin="0,0,8,0">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>
            <ScrollViewer x:Name="TrayScroll" VerticalScrollBarVisibility="Auto" HorizontalScrollMode="Disabled"
                          Margin="0,0,0,8">
                <Grid ColumnSpacing="8">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <Border x:Name="InputTrayHost"/>
                    <Border x:Name="AssyTrayHost" Grid.Column="1"/>
                </Grid>
            </ScrollViewer>
            <!-- Thứ tự Tool 1, Tool 2, Top; ba card rộng bằng nhau, bảng số cao bằng nhau nên ba khung ảnh thẳng hàng. -->
            <Grid Grid.Row="1" ColumnSpacing="8">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>
                <Border x:Name="Tool1CamHost"/>
                <Border x:Name="Tool2CamHost" Grid.Column="1"/>
                <Border x:Name="TopCamHost" Grid.Column="2"/>
            </Grid>
        </Grid>

        <!-- ═══ Cột phải: log trực tiếp (§2.5), ẩn/hiện được. LogHost co về 0 còn LogCard giữ nguyên bề rộng (phần thừa bị cắt)
             để chữ trong log không xuống dòng lại từng khung hình. ═══ -->
        <Grid Grid.Column="2">
            <Button x:Name="LogShowButton" Width="24" Height="56" MinHeight="0" Padding="0"
                    HorizontalAlignment="Right" VerticalAlignment="Center" Visibility="Collapsed" Opacity="0"
                    Click="OnToggleLogClick">
                <FontIcon Glyph="&#xE76B;" FontSize="12" FontFamily="{StaticResource SegoeIcons}"/>
            </Button>
            <Border x:Name="LogHost" Width="290" HorizontalAlignment="Right">
                <Border x:Name="LogCard" Width="290" HorizontalAlignment="Left" Style="{StaticResource CardBorderStyle}"
                        Padding="0">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                        </Grid.RowDefinitions>
                        <Border Style="{StaticResource CardHeaderStyle}" Padding="12,0,8,0">
                            <Grid>
                                <TextBlock Text="LOG" Style="{StaticResource SectionHeaderStyle}"/>
                                <Button x:Name="LogHideButton" Width="36" Height="32" MinHeight="0" Padding="0"
                                        HorizontalAlignment="Right" VerticalAlignment="Center" Click="OnToggleLogClick">
                                    <FontIcon Glyph="&#xE76C;" FontSize="12" FontFamily="{StaticResource SegoeIcons}"/>
                                </Button>
                            </Grid>
                        </Border>
                        <Border Grid.Row="1" Style="{StaticResource DividerStyle}"/>
                        <Border x:Name="LogListHost" Grid.Row="2" Padding="0,4,0,4"/>
                    </Grid>
                </Border>
            </Border>
        </Grid>
    </Grid>
</UserControl>
