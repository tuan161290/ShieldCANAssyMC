<?xml version="1.0" encoding="utf-8"?>
<Project DefaultTargets="Build" xmlns="http://schemas.microsoft.com/developer/msbuild/2003">
  <!--
    Kiểm thử lõi không cần giao diện, không cần phần cứng (FakeAxis / FakeIo / FakeVision / ổ A6SF giả trong bộ nhớ):
      CoreTests.exe            chạy mọi nhóm kiểm thử (mã thoát 0 = đạt hết)
      CoreTests.exe vmprobe    thử thiết bị VisionMaster thật (SDK C++) — cần máy đã cài VisionMaster 4.4
  -->
  <ItemGroup Label="ProjectConfigurations">
    <ProjectConfiguration Include="Debug|x64">
      <Configuration>Debug</Configuration>
      <Platform>x64</Platform>
    </ProjectConfiguration>
    <ProjectConfiguration Include="Release|x64">
      <Configuration>Release</Configuration>
      <Platform>x64</Platform>
    </ProjectConfiguration>
  </ItemGroup>
  <PropertyGroup Label="Globals">
    <ProjectGuid>{7C4D2E10-5B8A-4F61-A3C2-9E1B6D0F4A03}</ProjectGuid>
    <Keyword>Win32Proj</Keyword>
    <RootNamespace>CoreTests</RootNamespace>
    <WindowsTargetPlatformVersion>10.0</WindowsTargetPlatformVersion>
    <VmSdkRoot Condition="'$(VmSdkRoot)'==''">C:\Program Files\VisionMaster4.4.0\Development\V4.x</VmSdkRoot>
  </PropertyGroup>
  <Import Project="$(VCTargetsPath)\Microsoft.Cpp.Default.props" />
  <PropertyGroup Label="Configuration">
    <ConfigurationType>Application</ConfigurationType>
    <PlatformToolset>v145</PlatformToolset>
    <CharacterSet>Unicode</CharacterSet>
  </PropertyGroup>
  <PropertyGroup Condition="'$(Configuration)'=='Debug'" Label="Configuration">
    <UseDebugLibraries>true</UseDebugLibraries>
  </PropertyGroup>
  <PropertyGroup Condition="'$(Configuration)'=='Release'" Label="Configuration">
    <UseDebugLibraries>false</UseDebugLibraries>
    <WholeProgramOptimization>false</WholeProgramOptimization>
  </PropertyGroup>
  <Import Project="$(VCTargetsPath)\Microsoft.Cpp.props" />
  <PropertyGroup>
    <RootDir>$(MSBuildThisFileDirectory)..\..\</RootDir>
    <ServoDir Condition="'$(ServoDir)'==''">$(RootDir)..\..\ServoControl\Cpp\</ServoDir>
    <OutDir>$(RootDir)build\$(Platform)\$(Configuration)\CoreTests\</OutDir>
    <IntDir>$(RootDir)build\obj\$(Platform)\$(Configuration)\CoreTests\</IntDir>
  </PropertyGroup>
  <ItemDefinitionGroup>
    <ClCompile>
      <LanguageStandard>stdcpp20</LanguageStandard>
      <ConformanceMode>true</ConformanceMode>
      <ExceptionHandling>SyncCThrow</ExceptionHandling>
      <AdditionalOptions>%(AdditionalOptions) /utf-8 /bigobj</AdditionalOptions>
      <AdditionalIncludeDirectories>$(MSBuildThisFileDirectory);$(RootDir)Core;$(RootDir)ThirdParty;$(ServoDir);$(VmSdkRoot)\Includes;%(AdditionalIncludeDirectories)</AdditionalIncludeDirectories>
      <PreprocessorDefinitions>NOMINMAX;WIN32_LEAN_AND_MEAN;_CRT_SECURE_NO_WARNINGS;_CONSOLE;%(PreprocessorDefinitions)</PreprocessorDefinitions>
      <WarningLevel>Level3</WarningLevel>
      <DisableSpecificWarnings>4819;4828;%(DisableSpecificWarnings)</DisableSpecificWarnings>
      <SDLCheck>false</SDLCheck>
      <DebugInformationFormat>OldStyle</DebugInformationFormat>
      <MultiProcessorCompilation>true</MultiProcessorCompilation>
    </ClCompile>
    <Link>
      <SubSystem>Console</SubSystem>
      <GenerateDebugInformation>true</GenerateDebugInformation>
      <AdditionalLibraryDirectories>$(VmSdkRoot)\Libraries\win64\C;%(AdditionalLibraryDirectories)</AdditionalLibraryDirectories>
      <AdditionalDependencies>ws2_32.lib;winmm.lib;iMVS-6000PlatformSDK.lib;delayimp.lib;%(AdditionalDependencies)</AdditionalDependencies>
      <!-- Nạp trễ: máy không cài VisionMaster vẫn chạy được phần mô phỏng. EziMOTIONPlusE.dll nạp động (LoadLibrary). -->
      <DelayLoadDLLs>iMVS-6000PlatformSDK.dll;%(DelayLoadDLLs)</DelayLoadDLLs>
      <AdditionalOptions>%(AdditionalOptions) /IGNORE:4199</AdditionalOptions>
    </Link>
  </ItemDefinitionGroup>
  <ItemDefinitionGroup Condition="'$(Configuration)'=='Debug'">
    <ClCompile>
      <Optimization>Disabled</Optimization>
      <PreprocessorDefinitions>_DEBUG;%(PreprocessorDefinitions)</PreprocessorDefinitions>
    </ClCompile>
  </ItemDefinitionGroup>
  <ItemDefinitionGroup Condition="'$(Configuration)'=='Release'">
    <ClCompile>
      <Optimization>MaxSpeed</Optimization>
      <PreprocessorDefinitions>NDEBUG;%(PreprocessorDefinitions)</PreprocessorDefinitions>
    </ClCompile>
  </ItemDefinitionGroup>
  <ItemGroup>
    <ClCompile Include="*.cpp" />
    <ClInclude Include="*.h" />
  </ItemGroup>
  <ItemGroup>
    <ProjectReference Include="$(RootDir)Core\Core.vcxproj">
      <Project>{7C4D2E10-5B8A-4F61-A3C2-9E1B6D0F4A02}</Project>
    </ProjectReference>
    <ProjectReference Include="$(ServoDir)ServoControl.vcxproj">
      <Project>{7C4D2E10-5B8A-4F61-A3C2-9E1B6D0F4A10}</Project>
    </ProjectReference>
  </ItemGroup>
  <Import Project="$(VCTargetsPath)\Microsoft.Cpp.targets" />
</Project>
