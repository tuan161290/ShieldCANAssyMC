<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!-- ═══════════════════════════════════════════════════════ -->
    <!-- Windows 11 LIGHT theme — WinUI3 Fluent tokens            -->
    <!-- Tham khảo kiến trúc token/naming từ VisionApp.Core       -->
    <!-- (...\Tuan\Projects\VisionApp.Core\Styles\Colors.xaml,     -->
    <!-- bản gốc là Dark theme) — giá trị màu ở đây là bản LIGHT.  -->
    <!-- ═══════════════════════════════════════════════════════ -->

    <!-- Nền lớp dưới cùng (Mica base — thấy được qua khoảng hở giữa các card, xem
         MainWindow.xaml.cs.WindowBlurHelper) -->
    <Color x:Key="SolidBackgroundFillColorBase">#FFF3F3F3</Color>
    <Color x:Key="SolidBackgroundFillColorSecondary">#FFEEEEEE</Color>
    <Color x:Key="SolidBackgroundFillColorTertiary">#FFF9F9F9</Color>

    <!-- ═══ Ba lớp (Tuấn 2026-10-07): 1 Nền — Acrylic + tint xám sáng 60% (MainWindow.xaml.cs.BackdropTint);
         2 Card — trắng 70%, nổi rõ trên nền mà vẫn thấy blur xuyên qua; 3 Control — trắng đặc (nút, ô nhập).
         Không lồng card trong card; các nhóm trong một card ngăn bằng vạch mờ (DividerBrush). ═══ -->

    <!-- Card / Surface (panel nội dung nổi trên nền Acrylic) -->
    <Color x:Key="CardBackgroundFillColorDefault">#FFFFFFFF</Color>
    <Color x:Key="CardBackgroundFillColorTranslucent">#B3FFFFFF</Color>
    <Color x:Key="LayerFillColorDefault">#B3FFFFFF</Color>
    <Color x:Key="LayerFillColorAlt">#FFFFFFFF</Color>
    <Color x:Key="SubtleFillColorHover">#09000000</Color>
    <Color x:Key="SubtleFillColorPressed">#06000000</Color>

    <!-- Accent — Windows 11 default blue -->
    <Color x:Key="AccentColorLight1">#429CE3</Color>
    <Color x:Key="AccentColorDark1">#005A9E</Color>
    <Color x:Key="AccentFillColorDefault">#0078D4</Color>
    <Color x:Key="AccentFillColorHover">#106EBE</Color>
    <Color x:Key="AccentFillColorPressed">#005A9E</Color>

    <!-- Text -->
    <Color x:Key="TextFillColorPrimary">#E4000000</Color>
    <Color x:Key="TextFillColorSecondary">#9E000000</Color>
    <Color x:Key="TextFillColorTertiary">#72000000</Color>
    <Color x:Key="TextFillColorDisabled">#5C000000</Color>

    <!-- Stroke / Border -->
    <Color x:Key="ControlStrokeColorDefault">#0F000000</Color>
    <Color x:Key="ControlStrokeColorSecondary">#29000000</Color>
    <!-- Bumped từ #0F (6%, chuẩn WinUI3 khi có Mica/Acrylic thật phía sau) lên #33 (20%) — nền Mica
         hiện chưa cho hiệu ứng blur rõ (desktop wallpaper phẳng màu), viền quá mờ khiến card không
         phân biệt được với nền, group-box trông như không có viền. -->
    <Color x:Key="CardStrokeColorDefault">#33000000</Color>
    <!-- Vạch mờ ngăn các nhóm trong cùng một card (2026-10-07) — nhạt hơn hẳn viền card. -->
    <Color x:Key="DividerColorDefault">#1A000000</Color>

    <!-- Nút bấm — CỐ Ý tách riêng khỏi CardBackgroundFillColorTranslucent (SurfaceTranslucentBrush).
         Trước đây FlatButtonStyle/MenuButtonStyle dùng CHUNG brush với card/GroupBox chứa nó nên
         nút và nền thẻ cùng một màu, chỉ phân biệt được nhờ viền ControlStrokeColorDefault (6% đen
         — gần như vô hình) → nút "biến mất" trên card, đúng phản ánh của người dùng. Alpha cao hơn
         hẳn (80% so với 40% của card) làm nút nổi thành khối trắng rõ, viền cũng đậm hơn
         (ControlStrokeColorSecondary 16% thay vì 6%). -->
    <!-- 2026-10-07: đặc hẳn — card đã lên 70% nên nút 80% sẽ lại chìm vào card. -->
    <Color x:Key="ButtonFillColorDefault">#FFFFFFFF</Color>

    <!-- Status (Win11 system colors, tông đậm hơn để đủ tương phản trên nền sáng) -->
    <Color x:Key="SystemFillColorSuccess">#0F7B0F</Color>
    <Color x:Key="SystemFillColorCaution">#9D5D00</Color>
    <Color x:Key="SystemFillColorCritical">#C42B1C</Color>

    <!-- Trạng thái "tắt/không hoạt động" trung tính — KHÔNG dùng đỏ (dành riêng cho lỗi/bất
         thường, xem SystemFillColorCritical/FaultBrush) hay xanh dương (dễ lẫn với trạng thái
         chọn/accent) để tránh hiểu nhầm "tắt" thành "lỗi" hay "đang chọn". -->
    <Color x:Key="StatusOffColor">#5C5C5C</Color>

    <!-- Palette khớp SYSTEM_VARS.cs (Color.FromArgb) — GIỮ NGUYÊN, đây là màu trạng thái
         nghiệp vụ thật (tray sản phẩm, nút máy...) không phải màu chrome, không đổi theo theme -->
    <Color x:Key="CustomLightGreenColor">#FF86C691</Color>
    <Color x:Key="CustomDarkGreenColor">#FF389853</Color>
    <Color x:Key="CustomLightRedColor">#FFE94949</Color>
    <Color x:Key="CustomLightBlueColor">#FF4E6D9C</Color>
    <Color x:Key="CustomLightYellowColor">#FFFFFFC0</Color>
    <Color x:Key="NotUseColor">#FF464646</Color>
    <Color x:Key="BypassColor">#FFA5A5A5</Color>
    <Color x:Key="LaserOkColor">#FF78E600</Color>
    <Color x:Key="LaserNgColor">#FFB61616</Color>
    <Color x:Key="VisionOkColor">#FFC8EBC8</Color>

    <!-- Ô tray trang Main (2026-10-08: chuyển từ TrayCellVm.Fill sang đây — ViewModel không giữ màu). OK/NG/bỏ qua
         dùng lại màu nghiệp vụ ở trên; ô trống trắng như phím số Calculator (2026-09-15). -->
    <Color x:Key="TrayCellEmptyColor">#FFFFFFFF</Color>
    <Color x:Key="TrayCellLoadedColor">#FFCFE3F7</Color>
    <Color x:Key="TrayCellProcessingColor">#FFFFE080</Color>

    <!-- Màu nền/khung chung của shell — Win11 Mica Light -->
    <Color x:Key="ShellBackgroundColor">#FFF3F3F3</Color>
    <Color x:Key="PanelBackgroundColor">#CCFFFFFF</Color>
    <Color x:Key="BorderColor">#0F000000</Color>
    <Color x:Key="TextPrimaryColor">#E4000000</Color>
    <Color x:Key="TextOnDarkColor">#FFFFFFFF</Color>
    <Color x:Key="AccentColor">#0078D4</Color>

    <!-- ═══════════ BRUSHES ═══════════ -->

    <SolidColorBrush x:Key="BackgroundBrush" Color="{StaticResource SolidBackgroundFillColorBase}"/>
    <SolidColorBrush x:Key="BackgroundSecondaryBrush" Color="{StaticResource SolidBackgroundFillColorSecondary}"/>
    <SolidColorBrush x:Key="SurfaceBrush" Color="{StaticResource CardBackgroundFillColorDefault}"/>
    <SolidColorBrush x:Key="SurfaceTranslucentBrush" Color="{StaticResource CardBackgroundFillColorTranslucent}"/>
    <SolidColorBrush x:Key="LayerBrush" Color="{StaticResource LayerFillColorDefault}"/>
    <SolidColorBrush x:Key="LayerAltBrush" Color="{StaticResource LayerFillColorAlt}"/>
    <SolidColorBrush x:Key="SubtleHoverBrush" Color="{StaticResource SubtleFillColorHover}"/>
    <SolidColorBrush x:Key="SubtlePressedBrush" Color="{StaticResource SubtleFillColorPressed}"/>

    <SolidColorBrush x:Key="AccentFillBrush" Color="{StaticResource AccentFillColorDefault}"/>
    <SolidColorBrush x:Key="AccentHoverBrush" Color="{StaticResource AccentFillColorHover}"/>
    <SolidColorBrush x:Key="AccentPressedBrush" Color="{StaticResource AccentFillColorPressed}"/>
    <SolidColorBrush x:Key="TextOnAccentBrush" Color="White"/>

    <SolidColorBrush x:Key="TextSecondaryBrush" Color="{StaticResource TextFillColorSecondary}"/>
    <SolidColorBrush x:Key="TextTertiaryBrush" Color="{StaticResource TextFillColorTertiary}"/>
    <SolidColorBrush x:Key="TextDisabledBrush" Color="{StaticResource TextFillColorDisabled}"/>

    <SolidColorBrush x:Key="ControlStrokeBrush" Color="{StaticResource ControlStrokeColorDefault}"/>
    <SolidColorBrush x:Key="ControlStrokeSecondaryBrush" Color="{StaticResource ControlStrokeColorSecondary}"/>
    <SolidColorBrush x:Key="CardStrokeBrush" Color="{StaticResource CardStrokeColorDefault}"/>
    <SolidColorBrush x:Key="DividerBrush" Color="{StaticResource DividerColorDefault}"/>

    <!-- Nút bấm — xem ghi chú ButtonFillColorDefault ở trên -->
    <SolidColorBrush x:Key="ButtonFillBrush" Color="{StaticResource ButtonFillColorDefault}"/>
    <SolidColorBrush x:Key="ButtonStrokeBrush" Color="{StaticResource ControlStrokeColorSecondary}"/>
    <!-- Viền nút kiểu Windows 11 (2026-10-13, lấy theo Styles.xaml bản WinUI 3 của ShieldCanSlitAssy): cạnh dưới đậm
         hơn — nút trắng trông như khối nổi nhẹ trên card. -->
    <LinearGradientBrush x:Key="ButtonElevationStrokeBrush" StartPoint="0,0" EndPoint="0,1">
        <GradientStop Offset="0" Color="#FFE0E0E0"/>
        <GradientStop Offset="0.92" Color="#FFE0E0E0"/>
        <GradientStop Offset="1" Color="#FFC4C4C4"/>
    </LinearGradientBrush>

    <SolidColorBrush x:Key="SuccessBrush" Color="{StaticResource SystemFillColorSuccess}"/>
    <SolidColorBrush x:Key="CautionBrush" Color="{StaticResource SystemFillColorCaution}"/>
    <SolidColorBrush x:Key="CriticalBrush" Color="{StaticResource SystemFillColorCritical}"/>
    <SolidColorBrush x:Key="StatusOffBrush" Color="{StaticResource StatusOffColor}"/>

    <!-- Brushes (status nghiệp vụ, GIỮ NGUYÊN tên/giá trị) -->
    <SolidColorBrush x:Key="CustomLightGreenBrush" Color="{StaticResource CustomLightGreenColor}"/>
    <SolidColorBrush x:Key="CustomDarkGreenBrush" Color="{StaticResource CustomDarkGreenColor}"/>
    <SolidColorBrush x:Key="CustomLightRedBrush" Color="{StaticResource CustomLightRedColor}"/>
    <SolidColorBrush x:Key="CustomLightBlueBrush" Color="{StaticResource CustomLightBlueColor}"/>
    <SolidColorBrush x:Key="CustomLightYellowBrush" Color="{StaticResource CustomLightYellowColor}"/>
    <SolidColorBrush x:Key="NotUseBrush" Color="{StaticResource NotUseColor}"/>
    <SolidColorBrush x:Key="BypassBrush" Color="{StaticResource BypassColor}"/>
    <SolidColorBrush x:Key="LaserOkBrush" Color="{StaticResource LaserOkColor}"/>
    <SolidColorBrush x:Key="LaserNgBrush" Color="{StaticResource LaserNgColor}"/>
    <SolidColorBrush x:Key="VisionOkBrush" Color="{StaticResource VisionOkColor}"/>

    <!-- Ô tray trang Main — App.xaml gán vào converter TrayCellBrush. Ô lắp ráp còn trống đã quét OK tô cùng màu ô
         có hàng của tray đầu vào (Tuấn 2026-10-07). -->
    <SolidColorBrush x:Key="TrayCellEmptyBrush" Color="{StaticResource TrayCellEmptyColor}"/>
    <SolidColorBrush x:Key="TrayCellScannedBrush" Color="{StaticResource TrayCellLoadedColor}"/>
    <SolidColorBrush x:Key="TrayCellLoadedBrush" Color="{StaticResource TrayCellLoadedColor}"/>
    <SolidColorBrush x:Key="TrayCellProcessingBrush" Color="{StaticResource TrayCellProcessingColor}"/>
    <SolidColorBrush x:Key="TrayCellOkBrush" Color="{StaticResource CustomLightGreenColor}"/>
    <SolidColorBrush x:Key="TrayCellNgBrush" Color="{StaticResource CustomLightRedColor}"/>
    <SolidColorBrush x:Key="TrayCellSkippedBrush" Color="{StaticResource BypassColor}"/>

    <SolidColorBrush x:Key="ShellBackgroundBrush" Color="{StaticResource ShellBackgroundColor}"/>
    <SolidColorBrush x:Key="PanelBackgroundBrush" Color="{StaticResource PanelBackgroundColor}"/>
    <SolidColorBrush x:Key="BorderBrush" Color="{StaticResource BorderColor}"/>
    <SolidColorBrush x:Key="TextPrimaryBrush" Color="{StaticResource TextPrimaryColor}"/>
    <SolidColorBrush x:Key="TextOnDarkBrush" Color="{StaticResource TextOnDarkColor}"/>
    <SolidColorBrush x:Key="AccentBrush" Color="{StaticResource AccentColor}"/>

</ResourceDictionary>
