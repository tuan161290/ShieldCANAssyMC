<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:conv="clr-namespace:ShieldCanAssy.Wpf.Converters">

    <ResourceDictionary.MergedDictionaries>
        <ResourceDictionary Source="Palette.xaml"/>
    </ResourceDictionary.MergedDictionaries>

    <!-- Tag (bind IsOperator/IsManual/...) → màu chữ tab đang chọn/không chọn — dùng cho
         NavTabButtonStyle bên dưới, đặt trực tiếp làm Binding+Converter trên từng Button (không
         qua Style.Triggers) để tránh giới hạn Setter.TargetName (chỉ resolve được named part khi
         khai TRỰC TIẾP trong ControlTemplate.Triggers, không xuyên qua BasedOn). -->
    <conv:BoolToBrushConverter x:Key="NavTabForegroundBrush"
                               TrueBrush="{StaticResource TextPrimaryBrush}"
                               FalseBrush="{StaticResource TextSecondaryBrush}"/>

    <!-- BoolToVis riêng cho Controls.xaml — dictionary này được App.xaml merge VÀO, nên
         StaticResource khai trong App.xaml (kể cả "BoolToVis" chung) KHÔNG resolve ngược lại
         được ở đây (merge chỉ 1 chiều: cha thấy con, con không thấy cha). -->
    <BooleanToVisibilityConverter x:Key="LocalBoolToVis"/>

    <!-- ==== Typography Windows 11 (khớp VisionApp.Core/Styles/Fonts.xaml) ====
         ĐÃ THỬ đổi "Variable Display" → "Variable Text": không hết, vì ascent/descent của họ font
         "Segoe UI Variable" (mọi biến thể) được thiết kế cho WinUI3 — WPF tính chiều cao dòng chữ
         theo đúng chỉ số đó nên cao hơn hẳn Segoe UI cổ điển, không phụ thuộc biến thể nào, khiến
         chữ tràn khỏi TextBox/Button cao 24-28px dù cỡ chữ chỉ 10-13px. Bỏ hẳn "Variable", quay về
         Segoe UI cổ điển — chỉ số dòng chuẩn cho mọi cỡ, WPF vẫn dựng đúng như trước giờ. -->
    <FontFamily x:Key="SegoeUI">Segoe UI, sans-serif</FontFamily>
    <FontFamily x:Key="SegoeIcons">Segoe Fluent Icons, Segoe MDL2 Assets</FontFamily>

    <!-- FontAwesome — icon 3 nút điều khiển cửa sổ (theo yêu cầu người dùng, tham khảo cách
         CommonVisionApp nhúng font — xem Fonts\fontawesome-webfont.ttf). Tên nội bộ thật của
         font là "FontAwesome" (FontAwesome 4 webfont cổ điển). -->
    <FontFamily x:Key="FontAwesome">pack://application:,,,/Fonts/#FontAwesome</FontFamily>

    <!-- ==== TextBlock mặc định — áp cho mọi TextBlock không tự đặt FontFamily riêng (Style
         setter thắng inherited value nên đè được FontFamily="Tahoma" đặt ở root mỗi UserControl).
         KHÔNG đặt Foreground ở đây nữa (2026-09-11): implicit style TextBlock ở cấp App áp cả vào
         TextBlock mà ContentPresenter tự sinh ra để hiện Content dạng chuỗi BÊN TRONG template
         của Button/CheckBox/DataGridColumnHeader... — Style setter thắng giá trị kế thừa, nên chữ
         của MỌI nút bị ghim cứng TextPrimaryBrush bất kể Button.Foreground đặt gì: nút ON nền màu
         vẫn chữ đen thay vì trắng (Tuấn báo kèm ảnh: SVO on/MANUAL/IDLE), PrimaryButton cũng chữ
         đen trên nền xanh. Màu chữ mặc định giờ lấy qua kế thừa từ MainWindow.Foreground
         (TextPrimaryBrush) — TextBlock thường vẫn ra đúng màu cũ, còn chữ trong nút đi theo
         Foreground của chính nút. ==== -->
    <Style TargetType="TextBlock">
        <Setter Property="FontFamily" Value="{StaticResource SegoeUI}"/>
    </Style>

    <!-- ==== Nút điều khiển cửa sổ (Minimize/Maximize) — custom title bar frameless ==== -->
    <Style x:Key="WindowControlButton" TargetType="Button">
        <Setter Property="Background" Value="Transparent"/>
        <Setter Property="Foreground" Value="{StaticResource TextSecondaryBrush}"/>
        <Setter Property="BorderThickness" Value="0"/>
        <Setter Property="FontSize" Value="12"/>
        <Setter Property="FontFamily" Value="{StaticResource FontAwesome}"/>
        <Setter Property="Width" Value="46"/>
        <Setter Property="Height" Value="32"/>
        <Setter Property="Cursor" Value="Hand"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Border x:Name="bd" Background="{TemplateBinding Background}">
                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="bd" Property="Background" Value="{StaticResource SubtleHoverBrush}"/>
                            <Setter Property="Foreground" Value="{StaticResource TextPrimaryBrush}"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- Nút Close — hover đỏ (Win11) -->
    <Style x:Key="WindowCloseButton" TargetType="Button" BasedOn="{StaticResource WindowControlButton}">
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Border x:Name="bd" Background="{TemplateBinding Background}">
                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="bd" Property="Background" Value="#C42B1C"/>
                            <Setter Property="Foreground" Value="White"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- ==== Nút menu shell (thay SimpleButton của DevExpress) — pill nav Win11 ==== -->
    <Style x:Key="MenuButtonStyle" TargetType="Button">
        <Setter Property="Background" Value="{StaticResource ButtonFillBrush}"/>
        <Setter Property="Foreground" Value="{StaticResource TextPrimaryBrush}"/>
        <Setter Property="BorderBrush" Value="{StaticResource ButtonStrokeBrush}"/>
        <Setter Property="BorderThickness" Value="1"/>
        <Setter Property="FontFamily" Value="{StaticResource SegoeUI}"/>
        <Setter Property="FontSize" Value="15"/>
        <Setter Property="FontWeight" Value="SemiBold"/>
        <Setter Property="Cursor" Value="Hand"/>
        <Setter Property="SnapsToDevicePixels" Value="True"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Border x:Name="Bd"
                            Background="{TemplateBinding Background}"
                            BorderBrush="{TemplateBinding BorderBrush}"
                            BorderThickness="{TemplateBinding BorderThickness}"
                            CornerRadius="6">
                        <ContentPresenter HorizontalAlignment="Center"
                                          VerticalAlignment="Center"/>
                    </Border>
                    <ControlTemplate.Triggers>
                        <!-- Hover: chỉ giảm Opacity, KHÔNG đổi Background — nhiều nút (control
                             panel, ô khay, menu đang chọn...) bind Background theo trạng thái
                             thật (màu máy/status), đổi Background lúc hover sẽ che mất màu đó. -->
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Bd" Property="Opacity" Value="0.75"/>
                        </Trigger>
                        <Trigger Property="IsPressed" Value="True">
                            <Setter TargetName="Bd" Property="Background" Value="{StaticResource AccentFillBrush}"/>
                            <Setter Property="Foreground" Value="White"/>
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter TargetName="Bd" Property="Opacity" Value="0.5"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- ==== Nút tab điều hướng shell (Operator/Manual/Model/System/Log/Edit) — style mặc định
         Windows 11 NavigationView/TabView: nền trong suốt, gạch chân accent khi đang chọn, KHÔNG
         còn nền pill đặc như MenuButtonStyle — tham khảo CommonVisionApp/Styles/TabControls.xaml
         (MainTabItem). Trạng thái "đang chọn" (IsOperator/IsManual/...) truyền qua Tag từng nút
         (MainWindow.xaml) rồi BIND (không Trigger) Visibility gạch chân theo TemplatedParent.Tag —
         Setter.TargetName chỉ resolve được named part khi Trigger khai TRỰC TIẾP trong
         ControlTemplate.Triggers CỦA CHÍNH style đó, không dùng được qua Style.Triggers dù có
         BasedOn (đã thử, lỗi MC4011); Binding thường thì không bị giới hạn này. Foreground tương
         tự: bind trực tiếp trên Button (MainWindow.xaml) qua NavTabForegroundBrush converter. -->
    <Style x:Key="NavTabButtonStyle" TargetType="Button">
        <Setter Property="Background" Value="Transparent"/>
        <!-- TextPrimary (trước khai TextSecondary): chữ tab thực tế LUÔN ra TextPrimary vì bị
             implicit style TextBlock ghim cứng (xem ghi chú style TextBlock ở trên) — sau khi gỡ
             lỗi đó, giữ đúng giao diện đang thấy; tab đang chọn phân biệt bằng gạch chân accent.
             Tab Alarm đổi sang chữ trắng khi có alarm qua AlarmNavTabButtonStyle (2026-09-11). -->
        <Setter Property="Foreground" Value="{StaticResource TextPrimaryBrush}"/>
        <Setter Property="BorderThickness" Value="0"/>
        <Setter Property="FontFamily" Value="{StaticResource SegoeUI}"/>
        <Setter Property="FontSize" Value="15"/>
        <Setter Property="FontWeight" Value="SemiBold"/>
        <Setter Property="Padding" Value="24,0"/>
        <Setter Property="Height" Value="56"/>
        <Setter Property="Margin" Value="2,0"/>
        <Setter Property="Cursor" Value="Hand"/>
        <Setter Property="SnapsToDevicePixels" Value="True"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Grid>
                        <Border x:Name="Bd" Background="{TemplateBinding Background}" CornerRadius="5">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"
                                              Margin="{TemplateBinding Padding}"/>
                        </Border>
                        <Border x:Name="indicator" Height="3" VerticalAlignment="Bottom" HorizontalAlignment="Stretch"
                                Background="{StaticResource AccentBrush}" CornerRadius="2"
                                Margin="16,0,16,4"
                                Visibility="{Binding Path=Tag, RelativeSource={RelativeSource TemplatedParent}, Converter={StaticResource LocalBoolToVis}}"/>
                    </Grid>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Bd" Property="Background" Value="{StaticResource SubtleHoverBrush}"/>
                        </Trigger>
                        <Trigger Property="IsPressed" Value="True">
                            <Setter TargetName="Bd" Property="Background" Value="{StaticResource SubtlePressedBrush}"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- Nút Nav tab "Alarm" — cùng hàng Main/Manual/Teaching/Setting/Vision Edit (Tuấn yêu cầu,
         2026-09-10). Mặc định (KHÔNG có alarm) giữ nguyên giao diện Nav tab bình thường. Có alarm
         thì DataTrigger đổi chữ sang TRẮNG, nằm trên nền đỏ đặc + glow phẳng của Border bọc ngoài
         (MainWindow.xaml) — 2026-09-11; trước là chữ đỏ + nền tint.
         CHỈ đổi Foreground ở ĐÂY — KHÔNG đặt Effect (glow) trên chính Button dùng style này.
         NavTabButtonStyle có ControlTemplate riêng (Grid lồng 2 Border); đặt Effect qua DataTrigger
         trực tiếp trên một Button dùng Style dựa theo Template này làm WPF (.NET Framework) ném
         XamlParseException "'{DependencyProperty.UnsetValue}' is not a valid value for property
         'Effect'" ngay lúc phần tử vừa khởi tạo mà điều kiện trigger đã đúng sẵn (đúng tình huống
         máy luôn có alarm Fatal ngay lúc khởi động — Tuấn báo lỗi kèm ảnh + log, 2026-09-10). Nền
         đặt trên Border BỌC NGOÀI Button ở MainWindow.xaml thay vì ở đây — xem ghi chú ở đó. -->
    <Style x:Key="AlarmNavTabButtonStyle" TargetType="Button" BasedOn="{StaticResource NavTabButtonStyle}">
        <Style.Triggers>
            <!-- CHỈ Foreground ở đây — Background CŨNG không đặt được qua Trigger trên chính nút
                 này (đã thử, xem lịch sử): NavTabButtonStyle có "Bd" Border dùng
                 Background="{TemplateBinding Background}" bên trong ControlTemplate, và Style-level
                 Trigger ghi đè property mà template ĐANG TemplateBinding cùng lúc trigger đã đúng
                 NGAY lúc tạo phần tử (máy luôn có alarm Fatal sẵn lúc khởi động) làm WPF ném
                 XamlParseException "'{DependencyProperty.UnsetValue}' is not a valid value for
                 property 'Background'" y hệt lỗi Effect trước đó (Tuấn báo lỗi kèm log, 2026-09-10).
                 Nền nổi bật đặt ở Border BỌC NGOÀI Button (MainWindow.xaml) — Border thường không
                 có ControlTemplate/TemplateBinding nên không dính lỗi này. -->
            <DataTrigger Binding="{Binding HasActiveAlarms}" Value="True">
                <Setter Property="Foreground" Value="{StaticResource TextOnAccentBrush}"/>
            </DataTrigger>
        </Style.Triggers>
    </Style>

    <!-- Nút menu đang được chọn (highlight) -->
    <Style x:Key="MenuButtonSelectedStyle" TargetType="Button" BasedOn="{StaticResource MenuButtonStyle}">
        <Setter Property="Background" Value="{StaticResource AccentFillBrush}"/>
        <Setter Property="BorderBrush" Value="Transparent"/>
        <Setter Property="Foreground" Value="White"/>
    </Style>

    <!-- ==== Nút trạng thái "đang BẬT" — style PHẲNG hiện đại (Tuấn yêu cầu, 2026-09-11) ====
         Mặt nút tô ĐẶC màu trạng thái + chữ trắng (TextOnAccentBrush), viền cùng màu nền, KHÔNG
         gradient/bevel/bóng đổ lệch, kèm glow PHẲNG cùng màu (…GlowEffect bên dưới). Cùng kiểu
         các nút chọn có sẵn ở trang Teaching (Chậm/Nhanh, Tray, Tool: AccentFillBrush + chữ
         trắng) nên cả app thống nhất một kiểu. Trạng thái TẮT: chữ ĐEN (TextPrimaryBrush mặc định
         của FlatButtonStyle — trước là chữ xám, Tuấn đổi 2026-09-11), viền xám, nền trong suốt
         (OutlineButtonStyle/CompactButtonStyle). Dùng ở: ManualView (SVO/Home/RST/Mở phanh),
         MainView (AUTO/MANUAL/IDLE-RUN/RESET), TeachingView (IoOnButtonStyle), MainWindow (RESET,
         tab Alarm).
         Lịch sử (Tuấn góp ý liên tiếp): neon viền gần trắng + mặt tint 22% trong suốt (2026-09-10)
         → trông giả (quầng sáng lộ xuyên mặt nút, viền chìm vào nền sáng); mặt đục gradient + glow
         dịu → "nổi khối 3D" (gradient sáng trên/đậm dưới chính là thứ tạo khối); phẳng không glow
         → thiếu hiệu ứng phát sáng; bản hiện tại (2026-09-11): phẳng + glow.
         Màu chọn để chữ trắng đủ tương phản (~4.2-4.5:1, chữ nút 14px SemiBold/Bold đọc rõ):
         xanh lá #198754, đỏ #DC3545, cam #D35400, xanh dương = accent #0078D4. Tách riêng khỏi
         CustomDarkGreenBrush/CautionBrush/CriticalBrush — mấy brush đó còn dùng làm màu chữ/status
         nghiệp vụ ở nhiều chỗ khác (SYSTEM_VARS.cs...) nên không đổi giá trị của chúng. -->
    <SolidColorBrush x:Key="GreenOnBrush" Color="#198754"/>
    <SolidColorBrush x:Key="RedOnBrush" Color="#DC3545"/>
    <SolidColorBrush x:Key="CautionOnBrush" Color="#D35400"/>
    <SolidColorBrush x:Key="BlueOnBrush" Color="{StaticResource AccentFillColorDefault}"/>
    <!-- Lime — màu trạng thái thứ 5 (Tuấn yêu cầu thêm 2026-09-10), CHƯA gán vào nút nào. -->
    <SolidColorBrush x:Key="LimeOnBrush" Color="#5E9E10"/>

    <!-- Glow PHẲNG cho nút đang BẬT — giả lập nút phát sáng, không phải khối nổi (Tuấn yêu cầu,
         2026-09-11). ShadowDepth=0: không lệch nên thành quầng sáng đều quanh nút chứ không phải
         bóng đổ; màu SÁNG hơn mặt nút một bậc (ánh sáng phát ra trông sáng hơn vật phát). Mặt nút
         đặc (…OnBrush) nên quầng chỉ lộ ra ở mép ngoài, lòng nút và chữ trắng giữ sạch nét. Chỉnh
         độ toả/đậm của glow toàn app ở BlurRadius/Opacity dưới đây. -->
    <DropShadowEffect x:Key="GreenGlowEffect" Color="#22C55E" BlurRadius="16" ShadowDepth="0" Opacity="0.75" RenderingBias="Quality"/>
    <DropShadowEffect x:Key="RedGlowEffect" Color="#FF4D5E" BlurRadius="16" ShadowDepth="0" Opacity="0.75" RenderingBias="Quality"/>
    <DropShadowEffect x:Key="CautionGlowEffect" Color="#FF7A1A" BlurRadius="16" ShadowDepth="0" Opacity="0.75" RenderingBias="Quality"/>
    <DropShadowEffect x:Key="BlueGlowEffect" Color="#3AA0FF" BlurRadius="16" ShadowDepth="0" Opacity="0.75" RenderingBias="Quality"/>
    <DropShadowEffect x:Key="LimeGlowEffect" Color="#84CC16" BlurRadius="16" ShadowDepth="0" Opacity="0.75" RenderingBias="Quality"/>

    <!-- ==== Nút thường — Win11 "Ghost/Card" button (bo góc, nền translucent) ====
         FontSize 14 + MinHeight 36 (Tuấn báo chữ/nút quá nhỏ, 2026-09-11 — trước đó nút kế thừa
         cỡ chữ mặc định 12 của WPF). MinHeight THẮNG Height đặt tại chỗ trong layout WPF (chiều
         cao thực = Max(MinHeight, Height)), nên mọi nút đang ghim Height="24..34" ở các View tự
         cao lên 36 mà không phải sửa từng nút; nút nào cần cao hơn (44/48 trang Main, 66 nút
         P1-P3 trang Teaching) vẫn giữ Height riêng của nó. Tăng tiếp 2 giá trị này thì kiểm tra
         lại các nút ghim Width cố định (dòng trục ManualView, dòng jog TeachingView...) kẻo tràn chữ. -->
    <Style x:Key="FlatButtonStyle" TargetType="Button">
        <Setter Property="Background" Value="{StaticResource ButtonFillBrush}"/>
        <Setter Property="Foreground" Value="{StaticResource TextPrimaryBrush}"/>
        <Setter Property="BorderBrush" Value="{StaticResource ButtonStrokeBrush}"/>
        <Setter Property="BorderThickness" Value="1"/>
        <Setter Property="Padding" Value="10,5"/>
        <Setter Property="FontFamily" Value="{StaticResource SegoeUI}"/>
        <Setter Property="FontSize" Value="14"/>
        <Setter Property="MinHeight" Value="36"/>
        <Setter Property="Cursor" Value="Hand"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Border x:Name="Bd" Background="{TemplateBinding Background}"
                            BorderBrush="{TemplateBinding BorderBrush}"
                            BorderThickness="{TemplateBinding BorderThickness}"
                            CornerRadius="6" Padding="{TemplateBinding Padding}">
                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Border>
                    <ControlTemplate.Triggers>
                        <!-- Hover/Pressed: chỉ giảm Opacity, KHÔNG đổi Background — rất nhiều nút
                             dùng style này bind Background theo trạng thái thật (màu máy/status ô
                             khay), đổi Background lúc hover/nhấn sẽ che mất màu đó. -->
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Bd" Property="Opacity" Value="0.75"/>
                        </Trigger>
                        <Trigger Property="IsPressed" Value="True">
                            <Setter TargetName="Bd" Property="Opacity" Value="0.6"/>
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter TargetName="Bd" Property="Opacity" Value="0.5"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- Nút viền/chữ đổi màu theo trạng thái, nền LUÔN trong suốt — kiểu SVO on/off bên
         ManualView (không BAO GIỜ tô đặc nền, chỉ đổi viền/chữ + glow nhạt khi ON). Dùng làm nền
         cho các nút trạng thái AUTO/MANUAL/IDLE-RUN/RESET ở MainView (Tuấn yêu cầu, 2026-09-08). -->
    <Style x:Key="OutlineButtonStyle" TargetType="Button" BasedOn="{StaticResource FlatButtonStyle}">
        <Setter Property="Background" Value="Transparent"/>
    </Style>

    <!-- Style mặc định áp cho mọi Button (không cần đặt tên) -->
    <Style TargetType="Button" BasedOn="{StaticResource FlatButtonStyle}"/>

    <!-- AccentButton — nút hành động chính (WinUI3 Primary), dùng khi cần nhấn mạnh -->
    <Style x:Key="PrimaryButton" TargetType="Button" BasedOn="{StaticResource FlatButtonStyle}">
        <Setter Property="Background" Value="{StaticResource AccentFillBrush}"/>
        <Setter Property="BorderBrush" Value="Transparent"/>
        <Setter Property="Foreground" Value="White"/>
        <Setter Property="FontWeight" Value="SemiBold"/>
    </Style>

    <!-- ==== TextBox — Win11 (bo góc, viền accent khi focus) ====
         Chiều cao đặt bằng MinHeight, KHÔNG bằng Height — ở đây và cả trong các View (2026-09-16, Tuấn
         báo chữ trong mọi TextBox bị cắt ngang). Height cứng thì khung không nở ra được: máy nào dựng
         "Segoe UI" ra font có ascent/descent cao hơn (thiếu font nên thay thế, hoặc bản Windows khác) là
         dòng chữ cao hơn phần còn lại sau khi trừ viền và Padding, và phần thừa bị ScrollViewer trong
         template cắt đi — không có cảnh báo nào, chỉ thấy chữ cụt đuôi. Đúng lỗi đã gặp với họ font
         "Segoe UI Variable" (ghi ở mục Typography trên). Với MinHeight, khung cao đúng như cũ khi chữ vừa,
         và tự nớ thêm khi chữ cao hơn. -->
    <Style TargetType="TextBox">
        <Setter Property="Background" Value="{StaticResource SurfaceBrush}"/>
        <Setter Property="Foreground" Value="{StaticResource TextPrimaryBrush}"/>
        <Setter Property="BorderBrush" Value="{StaticResource ControlStrokeBrush}"/>
        <Setter Property="BorderThickness" Value="1"/>
        <Setter Property="MinHeight" Value="24"/>
        <Setter Property="Padding" Value="6,2"/>
        <Setter Property="FontFamily" Value="{StaticResource SegoeUI}"/>
        <Setter Property="FontSize" Value="13"/>
        <Setter Property="VerticalContentAlignment" Value="Center"/>
        <Setter Property="CaretBrush" Value="{StaticResource TextPrimaryBrush}"/>
        <Setter Property="SelectionBrush" Value="{StaticResource AccentFillBrush}"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="TextBox">
                    <Border x:Name="border" Background="{TemplateBinding Background}"
                            BorderBrush="{TemplateBinding BorderBrush}"
                            BorderThickness="{TemplateBinding BorderThickness}"
                            CornerRadius="4">
                        <!-- PART_ContentHost KHÔNG tự canh giữa theo VerticalContentAlignment của
                             TextBox nếu không gán VerticalAlignment tường minh — thiếu dòng này là
                             lý do chữ tràn lên trên khỏi khung khi dòng chữ cao hơn phần nội dung
                             còn lại sau khi trừ Padding. -->
                        <ScrollViewer x:Name="PART_ContentHost" Margin="{TemplateBinding Padding}"
                                      VerticalAlignment="Center"
                                      VerticalScrollBarVisibility="Hidden" HorizontalScrollBarVisibility="Hidden"/>
                    </Border>
                    <ControlTemplate.Triggers>
                        <!-- Trước có tăng BorderThickness 1→1.5 lúc focus — viền dày thêm ăn
                             ngược vào phần chứa chữ (Margin=Padding tính từ mép Border), đủ để
                             cắt đuôi chữ (g, y...) đúng lúc focus. Focus giờ chỉ đổi màu, không
                             đổi bề dày, để vùng chứa chữ ổn định bất kể trạng thái. -->
                        <Trigger Property="IsFocused" Value="True">
                            <Setter TargetName="border" Property="BorderBrush" Value="{StaticResource AccentFillBrush}"/>
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter TargetName="border" Property="Opacity" Value="0.5"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- ==== ComboBox (dùng template mặc định, chỉ chỉnh nhẹ — template dropdown mặc định
         phức tạp, không viết lại để tránh gãy hành vi popup) ==== -->
    <Style TargetType="ComboBox">
        <Setter Property="FontFamily" Value="{StaticResource SegoeUI}"/>
        <Setter Property="Padding" Value="6,4"/>
        <Setter Property="VerticalContentAlignment" Value="Center"/>
    </Style>

    <!-- ==== ScrollBar — Win11 "overlay" thin scrollbar (File Explorer/Edge): track trong suốt,
         thumb mỏng bo tròn, phồng nhẹ (Margin 3→1) + đổi màu khi hover/kéo, không còn nút mũi tên
         đầu/cuối vuông vức cổ điển. Style TargetType chung (không x:Key) nên áp ngầm cho MỌI
         ScrollBar trong app — ScrollViewer/DataGrid/ComboBox đều dùng lại control này bên trong,
         không cần style riêng từng nơi. ==== -->
    <Style x:Key="ScrollBarLineButtonStyle" TargetType="RepeatButton">
        <Setter Property="IsTabStop" Value="False"/>
        <Setter Property="Focusable" Value="False"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="RepeatButton">
                    <Rectangle Fill="Transparent"/>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style x:Key="ScrollBarThumbStyle" TargetType="Thumb">
        <Setter Property="IsTabStop" Value="False"/>
        <Setter Property="Focusable" Value="False"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Thumb">
                    <Border x:Name="thumbBd" Background="{StaticResource ControlStrokeSecondaryBrush}" CornerRadius="3" Margin="3"/>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="thumbBd" Property="Background" Value="{StaticResource TextSecondaryBrush}"/>
                            <Setter TargetName="thumbBd" Property="Margin" Value="1"/>
                        </Trigger>
                        <Trigger Property="IsDragging" Value="True">
                            <Setter TargetName="thumbBd" Property="Background" Value="{StaticResource AccentFillBrush}"/>
                            <Setter TargetName="thumbBd" Property="Margin" Value="1"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <ControlTemplate x:Key="VerticalScrollBarTemplate" TargetType="ScrollBar">
        <Grid Background="{TemplateBinding Background}">
            <Track x:Name="PART_Track" IsDirectionReversed="True">
                <Track.DecreaseRepeatButton>
                    <RepeatButton Style="{StaticResource ScrollBarLineButtonStyle}" Command="ScrollBar.PageUpCommand"/>
                </Track.DecreaseRepeatButton>
                <Track.Thumb>
                    <Thumb Style="{StaticResource ScrollBarThumbStyle}" MinHeight="24"/>
                </Track.Thumb>
                <Track.IncreaseRepeatButton>
                    <RepeatButton Style="{StaticResource ScrollBarLineButtonStyle}" Command="ScrollBar.PageDownCommand"/>
                </Track.IncreaseRepeatButton>
            </Track>
        </Grid>
    </ControlTemplate>

    <ControlTemplate x:Key="HorizontalScrollBarTemplate" TargetType="ScrollBar">
        <Grid Background="{TemplateBinding Background}">
            <Track x:Name="PART_Track" IsDirectionReversed="False">
                <Track.DecreaseRepeatButton>
                    <RepeatButton Style="{StaticResource ScrollBarLineButtonStyle}" Command="ScrollBar.PageLeftCommand"/>
                </Track.DecreaseRepeatButton>
                <Track.Thumb>
                    <Thumb Style="{StaticResource ScrollBarThumbStyle}" MinWidth="24"/>
                </Track.Thumb>
                <Track.IncreaseRepeatButton>
                    <RepeatButton Style="{StaticResource ScrollBarLineButtonStyle}" Command="ScrollBar.PageRightCommand"/>
                </Track.IncreaseRepeatButton>
            </Track>
        </Grid>
    </ControlTemplate>

    <Style TargetType="ScrollBar">
        <Setter Property="Background" Value="Transparent"/>
        <Setter Property="Width" Value="12"/>
        <Setter Property="MinWidth" Value="12"/>
        <Setter Property="Template" Value="{StaticResource VerticalScrollBarTemplate}"/>
        <Style.Triggers>
            <Trigger Property="Orientation" Value="Horizontal">
                <Setter Property="Width" Value="Auto"/>
                <Setter Property="Height" Value="12"/>
                <Setter Property="MinWidth" Value="0"/>
                <Setter Property="MinHeight" Value="12"/>
                <Setter Property="Template" Value="{StaticResource HorizontalScrollBarTemplate}"/>
            </Trigger>
        </Style.Triggers>
    </Style>

    <!-- ==== Tiêu đề card (Tuấn 2026-10-07): chữ VIẾT HOA — WPF không có text-transform nên viết hoa ngay trong chuỗi —,
         đặt trong CardHeaderStyle để có vạch mờ ngăn với nội dung. Dòng tiêu đề có nút đi kèm (Clear, ẩn Nhật ký…) thì
         bọc cả dòng. ==== -->
    <Style x:Key="SectionHeaderStyle" TargetType="TextBlock">
        <Setter Property="FontFamily" Value="{StaticResource SegoeUI}"/>
        <Setter Property="FontSize" Value="13"/>
        <Setter Property="FontWeight" Value="SemiBold"/>
        <Setter Property="Foreground" Value="{StaticResource TextPrimaryBrush}"/>
        <Setter Property="VerticalAlignment" Value="Center"/>
    </Style>

    <Style x:Key="CardHeaderStyle" TargetType="Border">
        <Setter Property="DockPanel.Dock" Value="Top"/>
        <Setter Property="BorderBrush" Value="{StaticResource DividerBrush}"/>
        <Setter Property="BorderThickness" Value="0,0,0,1"/>
        <Setter Property="Padding" Value="0,0,0,6"/>
        <Setter Property="Margin" Value="0,0,0,8"/>
    </Style>

    <!-- ==== GroupBox — một CARD (lớp 2 trong 3 lớp Nền — Card — Control), áp ngầm cho MỌI GroupBox trong app.
         Từ 2026-10-07 trông y hệt CardBorderStyle: đệm 10, tiêu đề như SectionHeaderStyle (14 SemiBold chữ chính) —
         trước đó trang Manual trộn GroupBox (đệm 12, tiêu đề 13 chữ xám) với card nên hai loại lệch nhau. ==== -->
    <Style TargetType="GroupBox">
        <Setter Property="Background" Value="{StaticResource SurfaceTranslucentBrush}"/>
        <Setter Property="BorderBrush" Value="{StaticResource CardStrokeBrush}"/>
        <Setter Property="Foreground" Value="{StaticResource TextPrimaryBrush}"/>
        <Setter Property="Padding" Value="10"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="GroupBox">
                    <Border Background="{TemplateBinding Background}"
                            BorderBrush="{TemplateBinding BorderBrush}"
                            BorderThickness="1" CornerRadius="8">
                        <DockPanel Margin="{TemplateBinding Padding}">
                            <Border Style="{StaticResource CardHeaderStyle}">
                                <ContentPresenter ContentSource="Header">
                                    <ContentPresenter.Resources>
                                        <Style TargetType="TextBlock">
                                            <Setter Property="FontFamily" Value="{StaticResource SegoeUI}"/>
                                            <Setter Property="FontSize" Value="13"/>
                                            <Setter Property="FontWeight" Value="SemiBold"/>
                                            <Setter Property="Foreground" Value="{StaticResource TextPrimaryBrush}"/>
                                        </Style>
                                    </ContentPresenter.Resources>
                                </ContentPresenter>
                            </Border>
                            <ContentPresenter/>
                        </DockPanel>
                    </Border>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- Style Border "card" dùng trực tiếp (không phải GroupBox) — OperatorView/ManualControlPanel
         định nghĩa style riêng (GroupBorderStyle/AxisGroupStyle) tự BasedOn style này để đồng bộ. -->
    <Style x:Key="CardBorderStyle" TargetType="Border">
        <Setter Property="Background" Value="{StaticResource SurfaceTranslucentBrush}"/>
        <Setter Property="BorderBrush" Value="{StaticResource CardStrokeBrush}"/>
        <Setter Property="BorderThickness" Value="1"/>
        <Setter Property="CornerRadius" Value="8"/>
        <Setter Property="Padding" Value="10"/>
    </Style>

    <!-- ==== Vạch mờ ngăn các nhóm trong một card (Tuấn 2026-10-07) — chỉ dùng <Separator/>, không lồng hộp viền
         trong card. Áp ngầm cho mọi Separator; Margin đặt tại chỗ nếu cần khoảng khác. ==== -->
    <Style TargetType="Separator">
        <Setter Property="Margin" Value="0,2,0,8"/>
        <Setter Property="Focusable" Value="False"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Separator">
                    <Rectangle Height="1" Fill="{StaticResource DividerBrush}" SnapsToDevicePixels="True"/>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- ==== Tab con trong một trang (trang Setting chia tab — Tuấn 2026-10-10). Cùng kiểu tab shell
         (NavTabButtonStyle) nhưng nhỏ hơn một bậc: nền trong suốt, tab đang chọn chữ đậm màu chính + gạch chân accent.
         Dùng: <TabControl Style="{StaticResource SubTabControlStyle}">. ==== -->
    <Style x:Key="SubTabItemStyle" TargetType="TabItem">
        <Setter Property="FontFamily" Value="{StaticResource SegoeUI}"/>
        <Setter Property="FontSize" Value="14"/>
        <Setter Property="FontWeight" Value="SemiBold"/>
        <Setter Property="Foreground" Value="{StaticResource TextSecondaryBrush}"/>
        <Setter Property="Cursor" Value="Hand"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="TabItem">
                    <Grid Height="42" MinWidth="110">
                        <Border x:Name="Bd" Background="Transparent" CornerRadius="5" Margin="2,2,2,5">
                            <ContentPresenter ContentSource="Header" Margin="20,0"
                                              HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <Border x:Name="indicator" Height="3" VerticalAlignment="Bottom" Margin="14,0"
                                Background="{StaticResource AccentBrush}" CornerRadius="2" Visibility="Collapsed"/>
                    </Grid>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Bd" Property="Background" Value="{StaticResource SubtleHoverBrush}"/>
                        </Trigger>
                        <Trigger Property="IsSelected" Value="True">
                            <Setter TargetName="indicator" Property="Visibility" Value="Visible"/>
                            <Setter Property="Foreground" Value="{StaticResource TextPrimaryBrush}"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style x:Key="SubTabControlStyle" TargetType="TabControl">
        <Setter Property="ItemContainerStyle" Value="{StaticResource SubTabItemStyle}"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="TabControl">
                    <DockPanel>
                        <Border DockPanel.Dock="Top" BorderBrush="{StaticResource DividerBrush}" BorderThickness="0,0,0,1"
                                Margin="0,0,0,8">
                            <TabPanel IsItemsHost="True"/>
                        </Border>
                        <ContentPresenter ContentSource="SelectedContent"/>
                    </DockPanel>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- Banner nhắc việc nằm TRONG card (lớp control): nền vàng nhạt, không viền, bo 4 — không phải card riêng. -->
    <Style x:Key="NoticeBannerStyle" TargetType="Border">
        <Setter Property="Background" Value="{StaticResource CustomLightYellowBrush}"/>
        <Setter Property="CornerRadius" Value="4"/>
        <Setter Property="Padding" Value="8,6"/>
    </Style>

    <!-- ==== DataGrid (thay GridControl) — Win11: không còn kẻ ô lưới nặng, hover/selected mờ,
         header nền phụ nhạt ==== -->
    <Style TargetType="DataGrid">
        <Setter Property="Background" Value="Transparent"/>
        <Setter Property="RowBackground" Value="Transparent"/>
        <Setter Property="AlternatingRowBackground" Value="Transparent"/>
        <Setter Property="BorderBrush" Value="{StaticResource ControlStrokeBrush}"/>
        <Setter Property="BorderThickness" Value="1"/>
        <Setter Property="GridLinesVisibility" Value="Horizontal"/>
        <Setter Property="HorizontalGridLinesBrush" Value="{StaticResource DividerBrush}"/>
        <Setter Property="RowHeaderWidth" Value="0"/>
        <Setter Property="AutoGenerateColumns" Value="False"/>
        <Setter Property="CanUserAddRows" Value="False"/>
        <Setter Property="FontFamily" Value="{StaticResource SegoeUI}"/>
        <Setter Property="ColumnHeaderHeight" Value="34"/>
    </Style>

    <Style TargetType="DataGridColumnHeader">
        <Setter Property="Background" Value="{StaticResource BackgroundSecondaryBrush}"/>
        <Setter Property="Foreground" Value="{StaticResource TextSecondaryBrush}"/>
        <Setter Property="FontFamily" Value="{StaticResource SegoeUI}"/>
        <Setter Property="FontWeight" Value="SemiBold"/>
        <Setter Property="Padding" Value="10,7"/>
        <Setter Property="BorderBrush" Value="{StaticResource DividerBrush}"/>
        <Setter Property="BorderThickness" Value="0,0,1,1"/>
    </Style>

    <Style TargetType="DataGridRow">
        <Setter Property="Background" Value="Transparent"/>
        <Style.Triggers>
            <Trigger Property="IsMouseOver" Value="True">
                <Setter Property="Background" Value="{StaticResource SubtleHoverBrush}"/>
            </Trigger>
            <Trigger Property="IsSelected" Value="True">
                <Setter Property="Background" Value="{StaticResource SubtlePressedBrush}"/>
            </Trigger>
        </Style.Triggers>
    </Style>

    <Style TargetType="DataGridCell">
        <Setter Property="Background" Value="Transparent"/>
        <Setter Property="BorderThickness" Value="0"/>
        <Setter Property="Padding" Value="10,6"/>
        <Setter Property="Foreground" Value="{StaticResource TextPrimaryBrush}"/>
        <Style.Triggers>
            <Trigger Property="IsSelected" Value="True">
                <Setter Property="Background" Value="Transparent"/>
                <Setter Property="Foreground" Value="{StaticResource TextPrimaryBrush}"/>
            </Trigger>
        </Style.Triggers>
    </Style>

</ResourceDictionary>
